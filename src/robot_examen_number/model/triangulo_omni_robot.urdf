<?xml version="1.0"?>
<robot name="triangular_omni_robot">

  <material name="light_gray"> <color rgba="0.75 0.75 0.75 1.0"/> </material>
  <material name="dark_gray">  <color rgba="0.15 0.15 0.15 1.0"/> </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_examen_number/model/triangular_base.stl" scale="1 1 1"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_examen_number/model/triangular_base.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.0213" ixy="0" ixz="0"
               iyy="0.0213" iyz="0" izz="0.0200"/>
    </inertial>
  </link>

  <!-- MACRO ruedas: 3 vértices, yaw = ángulo_vértice + 90° -->

  <!-- RUEDA 0 — frente (90°), yaw=180° -->
  <link name="wheel_0">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000183" ixy="0" ixz="0"
               iyy="0.000183" iyz="0" izz="0.000250"/>
    </inertial>
  </link>
  <joint name="joint_wheel_0" type="continuous">
    <parent link="base_link"/>
    <child  link="wheel_0"/>
    <origin xyz="0.0000 0.2310 0.0" rpy="0 0 3.1416"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- RUEDA 1 — atrás-izquierda (210°), yaw=300° -->
  <link name="wheel_1">
   
  </joint>

  <!-- RUEDA 2 — atrás-derecha (330°), yaw=60° -->
  <link name="wheel_2">
   
  </joint>

</robot>
